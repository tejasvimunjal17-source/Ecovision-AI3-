# ==============================================================
# EcoVision AI — Smart Waste Management Platform
# Environment Variables Template
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to GitHub.
# ==============================================================

# ---- OpenRouter AI ----
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_SITE_URL=https://ecovision-ai.streamlit.app
OPENROUTER_APP_NAME=EcoVision AI

# ---- App / Security ----
APP_SECRET_KEY=change_this_to_a_long_random_string
SESSION_TIMEOUT_MINUTES=60

# ---- Database ----
DATABASE_PATH=database/ecovision.db

# ---- Supabase (see database/README.md — not yet wired into the running
# app; provided here so the values are ready once that piece lands) ----
# USE_SUPABASE MUST stay "false" (the default) until a future step
# explicitly changes this. Filling in the keys below does NOT switch
# anything over -- see database/supabase_client.py.
USE_SUPABASE=false
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Direct Postgres connection string (Dashboard -> Project Settings ->
# Database -> Connection string) -- different from SUPABASE_URL above.
# Only used by database/db_supabase.py (Step 5C).
SUPABASE_DB_URL=your_supabase_db_url_here

# ---- Municipality Branding ----
MUNICIPALITY_NAME=Municipal Corporation of Gurugram (MCG)
SUPPORT_EMAIL=support@ecovision-ai.example.in
SUPPORT_PHONE=+91-9999999999
