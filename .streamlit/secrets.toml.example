# ==============================================================
# EcoVision AI — Streamlit secrets template
# Copy this file to ".streamlit/secrets.toml" and fill in real values.
# NEVER commit your real secrets.toml — it's already in .gitignore.
#
# On Streamlit Community Cloud, paste the same TOML into
# Settings -> Secrets instead of committing a file at all.
# ==============================================================

# ---- Google OAuth (Streamlit's built-in st.login(), requires
# streamlit>=1.42.0 and the `Authlib` package — see requirements.txt) ----
# Setup steps are in DEPLOYMENT.md ("Google OAuth Setup").
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generate-a-long-random-string-here"
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- Everything below mirrors .env.example — Streamlit Cloud reads
# secrets from this file/box, not from a committed .env (see
# config/settings.py's docstring for the full precedence explanation). ----
# OPENROUTER_API_KEY = "sk-or-your-real-key"
# APP_SECRET_KEY = "generate-a-long-random-string"

# ---- Supabase (Step 5A: preparation only — database/db.py's SQLite
# implementation is still the app's active backend regardless of what's
# set here; see database/supabase_client.py and database/README.md) ----
# USE_SUPABASE MUST stay "false" until a later step explicitly changes
# this — filling in the values below does NOT switch anything over.
USE_SUPABASE = "false"
# SUPABASE_URL = "https://your-project-ref.supabase.co"
# SUPABASE_ANON_KEY = "your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"  # trusted/server-side only — never expose client-side
# SUPABASE_DB_URL = "postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres"  # direct Postgres connection, used by database/db_supabase.py
